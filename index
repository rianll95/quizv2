    }

    .options button:hover {
      background-color: #111;
    }

    .options .selected {
      background-color: #001e1e;
      border: 2px solid #00ff55;
    }

    #confirmBtn {
      background-color: #000;
      color: white;
      border: 2px solid #00ff55;
      padding: 15px;
      margin-top: 20px;
      border-radius: 10px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
      font-size: 16px;
      transition: all 0.4s ease;
      animation: pulse 2s infinite;
    }

    #confirmBtn:hover {
      background-color: #003300;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 5px #00ff55; }
      50% { box-shadow: 0 0 20px #00ff55; }
      100% { box-shadow: 0 0 5px #00ff55; }
    }

    .start-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      max-width: 400px;
      width: 100%;
    }

    input[type="text"] {
      padding: 12px;
      border-radius: 8px;
      border: none;
      width: 100%;
      font-size: 16px;
    }

    #startBtn {
      padding: 12px;
      background-color: #000;
      color: white;
      border: 2px solid #00ff55;
      font-weight: bold;
      font-size: 16px;
      border-radius: 10px;
      cursor: pointer;
      animation: pulse 2s infinite;
      width: 100%;
    }

    .hidden {
      display: none;
    }

    #ranking {
      background-color: #111;
      border-radius: 15px;
      padding: 20px;
      margin-top: 20px;
      width: 300px;
      box-shadow: 0 0 15px rgba(0, 255, 85, 0.4);
    }

    #ranking h2 {
      text-align: center;
